{
  "elements": [
    { "type": "SelectInstance", "name": "AdaptiveInstanceID", "caption": "Adaptive (ACIPS) instance" },
    { "type": "CheckBox", "name": "StandaloneMode", "caption": "Standalone Mode" },
    { "type": "SelectVariable", "name": "StandaloneModeLink", "caption": "Standalone Mode Link (Bool)" },
    { "type": "NumberSpinner", "name": "TimerInterval", "caption": "Processing Interval (seconds)", "digits": 0, "minimum": 5, "maximum": 600, "value": 60 },
    { "type": "NumberSpinner", "name": "Hysteresis", "caption": "Hysteresis (°C)", "digits": 1, "minimum": 0.1, "maximum": 5, "value": 0.5 },

    { "type": "NumberSpinner", "name": "WindowDebounceSec", "caption": "Window/Door debounce (seconds)", "digits": 0, "minimum": 0, "maximum": 120, "value": 10 },
    {
      "type": "Select",
      "name": "LogLevel",
      "caption": "Log level",
      "options": [
        { "label": "Error only", "value": 0 },
        { "label": "Warnings", "value": 1 },
        { "label": "Info", "value": 2 },
        { "label": "Debug (all messages)", "value": 3 }
      ],
      "value": 3
    },

    { "type": "Label", "label": "--- System-Wide Links ---" },
    { "type": "SelectVariable", "name": "HeatingActiveLink", "caption": "Heating Active Link (disables cooling)" },
    { "type": "SelectVariable", "name": "WinterModeID", "caption": "Winter status (Boolean: true = winter; cooling inactive)" },
    { "type": "SelectVariable", "name": "VentilationActiveLink", "caption": "Ventilation Active Link (disables cooling)" },
    { "type": "SelectVariable", "name": "MainACOnOffLink", "caption": "Main AC Unit (On/Off or Value)" },
    { "type": "SelectVariable", "name": "MainFanControlLink", "caption": "Main Fan Control (On/Off or Value)" },
    { "type": "SelectVariable", "name": "MainACPowerLink", "caption": "Main AC Power Control Link" },
    { "type": "SelectVariable", "name": "MainFanSpeedLink", "caption": "Main Fan Speed Control Link" },

    { "type": "Label", "label": "--- Standalone Mode Settings ---", "visible": "this.StandaloneMode" },
    { "type": "SelectVariable", "name": "StandalonePowerVar", "caption": "Standalone Power (Integer 0–100)", "visible": "this.StandaloneMode" },
    { "type": "SelectVariable", "name": "StandaloneFanVar",   "caption": "Standalone Fan Speed (Integer 0–100)", "visible": "this.StandaloneMode" },
    { "type": "NumberSpinner", "name": "ConstantPower", "caption": "Fallback: Constant Power (%)", "minimum": 0, "maximum": 100, "value": 80, "visible": "this.StandaloneMode" },
    { "type": "NumberSpinner", "name": "ConstantFanSpeed", "caption": "Fallback: Constant Fan Speed (%)", "minimum": 0, "maximum": 100, "value": 80, "visible": "this.StandaloneMode" },

    { "type": "Label", "label": "--- Notabschaltung (Spulenschutz) ---" },
    { "type": "SelectVariable", "name": "CoilTemperatureLink", "caption": "Spulentemperatur-Sensor" },
    { "type": "NumberSpinner", "name": "EmergencyShutdownTemp", "caption": "Abschalttemperatur (°C)", "digits": 1, "minimum": -5.0, "maximum": 15.0, "value": 1.0 },
    { "type": "NumberSpinner", "name": "EmergencyRestartTemp", "caption": "Wiedereinschalttemperatur (°C)", "digits": 1, "minimum": 0.0, "maximum": 15.0, "value": 5.0 },
    { "type": "NumberSpinner", "name": "EmergencyFanPercent", "caption": "Notbetrieb: Lüfter (%)", "digits": 0, "minimum": 0, "maximum": 100, "value": 60 },
    { "type": "CheckBox", "name": "EmergencyCloseFlaps", "caption": "Im Notfall Klappen schließen", "value": false },

    { "type": "Label", "label": "--- Controlled Rooms ---" },
    {
      "type": "List",
      "name": "ControlledRooms",
      "caption": "Controlled Rooms",
      "rowCount": 8,
      "add": true,
      "delete": true,
      "sort": { "column": "name", "direction": "ascending" },
      "columns": [
        { "caption": "Room Name", "name": "name", "width": "150px", "add": "New Room", "edit": { "type": "ValidationTextBox" } },
        { "caption": "Temp Sensor (IST)", "name": "tempID", "width": "200px", "add": 0, "edit": { "type": "SelectVariable" } },
        { "caption": "Target Temp (SOLL)", "name": "targetID", "width": "200px", "add": 0, "edit": { "type": "SelectVariable" } },
        { "caption": "Separate Demand Output (optional)", "name": "demandID", "width": "200px", "add": 0, "edit": { "type": "SelectVariable" }, "visible": "!this.StandaloneMode" },
        { "caption": "Room Size (m²)", "name": "size", "width": "110px","add": 20, "edit": { "type": "NumberSpinner", "minimum": 1, "maximum": 300 } },
        { "caption": "Threshold (°C)", "name": "threshold", "width": "110px","add": 0.5, "edit": { "type": "NumberSpinner", "digits": 1, "minimum": 0.0, "maximum": 5.0 } },
        { "caption": "Maximum AC Power When Sole Room (%)", "name": "maxSingleRoomPowerPercent", "width": "180px", "add": 100, "edit": { "type": "NumberSpinner", "digits": 0, "minimum": 1, "maximum": 100 } },
        { "caption": "Flap Control Variable", "name": "flapID", "width": "200px", "add": 0, "edit": { "type": "SelectVariable" } },
        {
          "caption": "Flap Type",
          "name": "flapType",
          "width": "140px",
          "add": "boolean",
          "edit": {
            "type": "Select",
            "options": [
              { "label": "Boolean", "value": "boolean" },
              { "label": "Linear (0-100)", "value": "linear" }
            ]
          }
        },
        { "caption": "Value for OPEN (boolean)", "name": "flapOpenValue", "width": "120px", "add": "true", "edit": { "type": "ValidationTextBox" }, "visible": "this.flapType === 'boolean'" },
        { "caption": "Value for CLOSED (boolean)", "name": "flapClosedValue", "width": "120px", "add": "false", "edit": { "type": "ValidationTextBox" }, "visible": "this.flapType === 'boolean'" },
        { "caption": "Open % (linear)", "name": "flapOpenLinear", "width": "120px", "add": 100, "edit": { "type": "NumberSpinner", "minimum": 0, "maximum": 100 }, "visible": "this.flapType === 'linear'" },
        { "caption": "Closed % (linear)", "name": "flapClosedLinear", "width": "120px", "add": 0, "edit": { "type": "NumberSpinner", "minimum": 0, "maximum": 100 }, "visible": "this.flapType === 'linear'" },
        { "caption": "Cooling Mode (1=Off, 2=Once, 3=Auto)", "name": "airSollStatusID", "width": "230px", "add": 0, "edit": { "type": "SelectVariable" } },
        { "caption": "Phase Info Output (Cooling_Phase_Info)", "name": "coolingPhaseInfoID", "width": "200px", "add": 0, "edit": { "type": "SelectVariable" } },
        { "caption": "Window/Door Category", "name": "windowCatID", "width": "200px", "add": 0, "edit": { "type": "SelectCategory" } }
      ]
    },

    { "type": "Label", "label": "--- Status ---" },
    { "type": "Label", "label": "Override aktiv (nur Anzeige):", "bold": true },
    { "type": "Label", "name": "OverrideActive", "caption": "—", "visible": true }
  ],
  "actions": [
    { "type": "Button", "caption": "Run zoning now", "onClick": "ZDM_ProcessZoning($id);" },
    {
      "type": "ExpansionPanel",
      "caption": "Configuration Backup / Restore",
      "expanded": false,
      "items": [
        {
          "type": "Label",
          "caption": "Export creates a backup of all module properties, including the complete room configuration. Runtime states are not included."
        },
        {
          "type": "ScriptEditor",
          "name": "ConfigBackupJson",
          "caption": "Configuration Backup JSON",
          "value": "",
          "rowCount": 12
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "Button",
              "caption": "Export Configuration",
              "onClick": "ZDM_UI_ExportConfig($id);"
            },
            {
              "type": "Button",
              "caption": "Import Configuration",
              "onClick": "echo ZDM_UI_ImportConfig($id, $ConfigBackupJson);",
              "confirm": "Importing replaces the current module configuration. Continue?"
            }
          ]
        }
      ]
    }
  ],
  "status": [
    { "code": 102, "icon": "active", "caption": "OK" },
    { "code": 202, "icon": "error", "caption": "Configuration incomplete" }
  ]
}
